# Database Configuration (SQLite for local zero-config, or PostgreSQL for production)
DATABASE_URL="file:./dev.db"
# For PostgreSQL: DATABASE_URL="postgresql://user:password@localhost:5432/vr_healthcare?schema=public"

# Admin Authentication Secret (min 32 characters in production)
JWT_SECRET="replace_with_secure_random_key_min_32_chars"

# Admin Initial Credentials
INITIAL_ADMIN_EMAIL="admin@vrhealthcare.com"
INITIAL_ADMIN_PASSWORD="ReplaceWithSecurePassword"

# Email Notifications (Optional SMTP setup)
ADMIN_NOTIFICATION_EMAIL="care@vrhealthcare.com"
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="smtp-username"
SMTP_PASS="smtp-password"
SMTP_FROM="noreply@vrhealthcare.com"

# Public Site Configuration
NEXT_PUBLIC_SITE_URL="https://vrhealthcare.com"
